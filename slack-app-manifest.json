{
  "display_information": {
    "name": "From Zulip",
    "description": "Experimental bridge for one agreed Zulip and Slack channel pair"
  },
  "features": {
    "bot_user": {"display_name": "From Zulip", "always_online": false}
  },
  "oauth_config": {
    "scopes": {
      "bot": ["channels:history", "channels:read", "chat:write", "users:read", "reactions:read", "reactions:write", "files:read", "files:write"]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "bot_events": ["message.channels", "reaction_added", "reaction_removed"]
    }
  }
}
