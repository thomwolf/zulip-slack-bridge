# Save as .env locally; never commit real credentials.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
ZULIP_BOT_EMAIL=from-slack-bot@your-organization.zulipchat.com
ZULIP_API_KEY=replace-me
# Optional: PEM trust bundle for a local Zulip test server.
# ZULIP_CA_BUNDLE=/absolute/path/to/test-ca.pem

# Optional, only when storage_backend = "turso". Keep the database token private.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=replace-me
